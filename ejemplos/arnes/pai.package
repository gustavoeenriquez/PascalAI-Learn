[package]
name    = arnes
version = 0.1.0
main    = Arnes.pas

; El modelo: Claude Haiku con la clave en la variable de entorno ANTHROPIC_API_KEY.
; Con otro proveedor, cambia esta sección y el primary de Arnes.pas (por ejemplo, un Ollama local).
[providers]
claude = url=https://api.anthropic.com/v1; key=$ANTHROPIC_API_KEY

; Lo que el asistente sabe del negocio (H03).
[skills]
cafe = skills/cafe

; tools auto: lo que el asistente puede instalar solo, y que pregunte antes (H03, H06).
[auto]
permitir = mcp-*
autores  = pascalai
aprobar  = instalar

; El correo simulado: un servidor MCP escrito en PascalAI (H04).
; Para el correo de verdad: mcp-imap y mcp-smtp del registro.
[mcp]
correo = stdio=$PAI run correo/Correo.pas --mcp-stdio
